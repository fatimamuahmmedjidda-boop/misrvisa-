// Local dev uses SQLite (zero-config, file-based).
// Before deploying to Vercel, switch provider to "postgresql" and set
// DATABASE_URL to a managed Postgres connection string (Neon, Vercel Postgres,
// or Supabase all work) — SQLite's local file does not survive on serverless.
// See README.md "Deployment" for the exact steps.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Note: values below are enforced at the application layer (see src/lib/validation.ts
// and src/lib/content/services.ts), not as native DB enums. SQLite has no enum
// support, and keeping these as strings means no schema change is needed when
// switching the datasource provider to Postgres for production.
//
// ServiceType:         VISA_ON_ARRIVAL | TICKET_ASSISTANCE | ACCOMMODATION | AIRPORT_PICKUP | OK_TO_BOARD
// ApplicationStatus:   RECEIVED | UNDER_REVIEW | DOCUMENTS_REQUIRED | PROCESSING | READY | COMPLETED | CANCELLED
// PartnerStatus:       NEW | CONTACTED | IN_DISCUSSION | ACTIVE | DECLINED

model Customer {
  id           String        @id @default(cuid())
  fullName     String
  nationality  String
  whatsapp     String
  email        String        @unique
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id                String            @id @default(cuid())
  trackingId        String            @unique
  customer          Customer          @relation(fields: [customerId], references: [id])
  customerId        String
  service           String
  travelDate        DateTime?
  travelPurpose     String
  additionalInfo    String?
  status            String            @default("RECEIVED")
  notes             String?
  assignedStaff     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([trackingId])
  @@index([status])
}

model PartnerApplication {
  id                String        @id @default(cuid())
  companyName       String
  contactPerson     String
  country           String
  phone             String
  email             String
  website           String?
  businessType      String
  expectedVolume    String?
  message           String?
  status            String        @default("NEW")
  createdAt         DateTime      @default(now())

  @@index([status])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  featuredImage   String?
  category        String
  author          String    @default("MISR VISA Team")
  seoTitle        String?
  metaDescription String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([published])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  customerName String?
  countryFlag  String?
  quote        String?
  isPlaceholder Boolean @default(true)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
