datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Note: values below are enforced at the application layer (see src/lib/validation.ts
// and src/lib/content/services.ts), not as native DB enums. SQLite has no enum
// support, and keeping these as strings means no schema change is needed when
// switching the datasource provider to Postgres for production.
//
// ServiceType:         VISA_ON_ARRIVAL | TICKET_ASSISTANCE | ACCOMMODATION | AIRPORT_PICKUP | OK_TO_BOARD
// ApplicationStatus:   RECEIVED | UNDER_REVIEW | DOCUMENTS_REQUIRED | PROCESSING | READY | COMPLETED | CANCELLED
// PartnerStatus:       NEW | CONTACTED | IN_DISCUSSION | ACTIVE | DECLINED

model Customer {
  id                 String        @id @default(cuid())
  fullName           String
  nationality        String
  whatsapp           String
  email              String        @unique
  passwordHash       String?
  referredByPartner  Partner?      @relation(fields: [referredByPartnerId], references: [id])
  referredByPartnerId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  // Bumped on password change so old JWT sessions stop being accepted.
  sessionVersion     Int           @default(0)
  emailVerifiedAt    DateTime?
  applications       Application[]
  invoices           Invoice[]
  payments           Payment[]
  documents          Document[]

  @@index([referredByPartnerId])
}

model Application {
  id                String            @id @default(cuid())
  trackingId        String            @unique
  customer          Customer          @relation(fields: [customerId], references: [id])
  customerId        String
  service           String
  travelDate        DateTime?
  travelPurpose     String
  additionalInfo    String?
  status            String            @default("RECEIVED")
  notes             String?
  assignedStaff     String?
  amountCharged     Float?
  partner           Partner?          @relation(fields: [partnerId], references: [id])
  partnerId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // STANDARD | VIP — a service level, not a status.
  serviceLevel      String            @default("STANDARD")
  statusChangedAt   DateTime?
  statusHistory     ApplicationStatusHistory[]
  invoices          Invoice[]
  payments          Payment[]
  commissions       Commission[]
  documents         Document[]

  @@index([trackingId])
  @@index([status])
  @@index([partnerId])
}

// Partner/agent accounts (created by admin only). Distinct from PartnerApplication,
// which is the public "Partner With Us" lead-inquiry form below.
model Partner {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  passwordHash      String
  referralCode      String        @unique
  commissionPercent Float         @default(10)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  sessionVersion    Int           @default(0)
  customers         Customer[]
  applications      Application[]
  invoices          Invoice[]
  commissions       Commission[]
}

model PartnerApplication {
  id                String        @id @default(cuid())
  companyName       String
  contactPerson     String
  country           String
  phone             String
  email             String
  website           String?
  businessType      String
  expectedVolume    String?
  message           String?
  status            String        @default("NEW")
  createdAt         DateTime      @default(now())

  @@index([status])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  featuredImage   String?
  category        String
  author          String    @default("MISR VISA Team")
  seoTitle        String?
  metaDescription String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([published])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  customerName String?
  countryFlag  String?
  quote        String?
  isPlaceholder Boolean @default(true)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// One-time password reset links for travelers and partners.
//
// The token is stored in plain text because staff deliver the link by hand
// (WhatsApp or email) from the admin area — they need to be able to read it.
// It is single-use and expires after an hour, and only signed-in admins can
// see it. If automatic reset emails are added later, switch this to storing
// a hash so nobody, including staff, can read a live token.
model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  userType  String // CUSTOMER | PARTNER
  // Deprecated: legacy plaintext token, kept only so existing rows still resolve.
  // New links are stored as `tokenHash` (SHA-256) and are never readable by staff.
  token     String    @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  createdAt          DateTime  @default(now())
  // OWNER | OPERATIONS | EDITOR — enforced server-side in src/lib/authz.ts.
  role               String    @default("OWNER")
  active             Boolean   @default(true)
  sessionVersion     Int       @default(0)
  // Architecture for TOTP 2FA; enrolment UI is a later phase.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?
  lastLoginAt        DateTime?
}

// ---------------------------------------------------------------------------
// Pricing. Prices are never edited in place: a new ServicePrice version is
// created and the previous one is closed with `effectiveTo`, so historical
// invoices can always be explained.
// ---------------------------------------------------------------------------

model Service {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  // Matches Application.service (VISA_ON_ARRIVAL, OK_TO_BOARD, ...) when the
  // service is bookable through the application form.
  dbValue     String?
  active      Boolean        @default(true)
  // Whether the government arrival fee / QR fee belong on this service's invoice.
  appliesGovernmentFee Boolean @default(false)
  appliesQrFee         Boolean @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  prices      ServicePrice[]
}

model ServicePrice {
  id                 String    @id @default(cuid())
  service            Service   @relation(fields: [serviceId], references: [id])
  serviceId          String
  // Base pricing currency for MISR VISA (USD today).
  currency           String    @default("USD")
  // All amounts are integer minor units (cents) — never floating point.
  serviceFeeMinor    Int
  vipSurchargeMinor  Int       @default(0)
  governmentFeeMinor Int       @default(0)
  qrFeeMinor         Int       @default(0)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  note               String?
  createdById        String?
  createdByEmail     String?
  createdAt          DateTime  @default(now())
  invoiceLines       InvoiceLine[]

  @@index([serviceId, effectiveTo])
}

model Currency {
  code       String   @id // ISO 4217: USD, NGN, EGP, XAF, GHS, KES
  name       String
  symbol     String
  minorUnits Int      @default(2)
  isBase     Boolean  @default(false)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExchangeRate {
  id             String    @id @default(cuid())
  baseCurrency   String    @default("USD")
  quoteCurrency  String
  // Units of quote currency per 1 unit of base currency.
  rate           Decimal   @db.Decimal(18, 6)
  // MANUAL today; AUTOMATIC can be added without schema changes.
  mode           String    @default("MANUAL")
  source         String?
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())

  @@index([baseCurrency, quoteCurrency, effectiveTo])
}

// ---------------------------------------------------------------------------
// Invoicing & payments. An invoice is a permanent snapshot: it never recomputes
// from today's prices or today's exchange rate.
// ---------------------------------------------------------------------------

model Invoice {
  id               String        @id @default(cuid())
  number           String        @unique
  application      Application   @relation(fields: [applicationId], references: [id])
  applicationId    String
  customer         Customer      @relation(fields: [customerId], references: [id])
  customerId       String
  partner          Partner?      @relation(fields: [partnerId], references: [id])
  partnerId        String?
  // DRAFT | ISSUED | PAID | PARTIALLY_PAID | CANCELLED | REFUNDED
  status           String        @default("ISSUED")
  serviceLevel     String        @default("STANDARD")
  baseCurrency     String        @default("USD")
  subtotalUsdMinor Int
  discountUsdMinor Int           @default(0)
  totalUsdMinor    Int
  // Currency the customer is charged in, and the rate snapshot used.
  chargeCurrency   String        @default("USD")
  exchangeRate     Decimal       @db.Decimal(18, 6)
  exchangeRateId   String?
  totalChargeMinor Int
  issuedAt         DateTime      @default(now())
  dueAt            DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  notes            String?
  createdByType    String        @default("SYSTEM")
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lines            InvoiceLine[]
  payments         Payment[]
  commissions      Commission[]

  @@index([applicationId])
  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id             String        @id @default(cuid())
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  // SERVICE_FEE | VIP_SURCHARGE | GOVERNMENT_FEE | QR_FEE | OPTIONAL_SERVICE | DISCOUNT
  kind           String
  label          String
  quantity       Int           @default(1)
  unitUsdMinor   Int
  amountUsdMinor Int
  // Which price version produced this line (traceability).
  servicePrice   ServicePrice? @relation(fields: [servicePriceId], references: [id])
  servicePriceId String?
  // Fees collected by the Egyptian authorities at the airport, not by MISR VISA.
  payableAtAirport Boolean     @default(false)
  sortOrder      Int           @default(0)

  @@index([invoiceId])
}

model Payment {
  id                 String    @id @default(cuid())
  invoice            Invoice   @relation(fields: [invoiceId], references: [id])
  invoiceId          String
  application        Application @relation(fields: [applicationId], references: [id])
  applicationId      String
  customer           Customer  @relation(fields: [customerId], references: [id])
  customerId         String
  partnerId          String?
  // PAYSTACK | FLUTTERWAVE | MANUAL_BANK | CASH
  provider           String
  providerReference  String    @unique
  providerEventId    String?
  amountMinor        Int
  currency           String
  baseAmountUsdMinor Int
  exchangeRate       Decimal   @db.Decimal(18, 6)
  // PENDING | PROCESSING | SUCCESS | FAILED | CANCELLED | REFUNDED | PARTIALLY_REFUNDED
  status             String    @default("PENDING")
  method             String?
  failureReason      String?
  refundedMinor      Int       @default(0)
  metadata           Json?
  createdAt          DateTime  @default(now())
  paidAt             DateTime?
  failedAt           DateTime?
  refundedAt         DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([applicationId])
  @@index([customerId])
  @@index([status])
}

// Raw provider events, so a webhook delivered twice is only ever processed once.
model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  reference   String?
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([reference])
}

model Commission {
  id                     String    @id @default(cuid())
  partner                Partner   @relation(fields: [partnerId], references: [id])
  partnerId              String
  application            Application @relation(fields: [applicationId], references: [id])
  applicationId          String
  invoice                Invoice   @relation(fields: [invoiceId], references: [id])
  invoiceId              String    @unique
  saleAmountUsdMinor     Int
  // Snapshot of the rate at the time of sale — later changes never rewrite history.
  commissionPercent      Float
  commissionAmountUsdMinor Int
  currency               String    @default("USD")
  // PENDING | APPROVED | PAID | CANCELLED
  status                 String    @default("PENDING")
  payoutReference        String?
  note                   String?
  createdAt              DateTime  @default(now())
  approvedAt             DateTime?
  paidAt                 DateTime?

  @@index([partnerId, status])
}

// ---------------------------------------------------------------------------
// Operations: status history, audit trail, and the document model (storage and
// upload are a separate security-reviewed phase — no files are handled yet).
// ---------------------------------------------------------------------------

model ApplicationStatusHistory {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  oldStatus     String?
  newStatus     String
  // ADMIN | CUSTOMER | PARTNER | SYSTEM
  changedByType String      @default("SYSTEM")
  changedById   String?
  changedByName String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // ADMIN | CUSTOMER | PARTNER | SYSTEM
  actorId    String?
  actorEmail String?
  action     String // PRICE_CHANGED, RATE_CHANGED, STATUS_CHANGED, ...
  entity     String
  entityId   String?
  // Never store secrets, tokens or passport data here.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Document {
  id              String      @id @default(cuid())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  customer        Customer    @relation(fields: [customerId], references: [id])
  customerId      String
  // PASSPORT | TICKET | PHOTO | HOTEL_BOOKING | OTHER
  type            String
  // Opaque key in PRIVATE storage. Never a public URL, never a guessable path.
  storageKey      String      @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  sha256          String?
  uploadedByType  String      @default("CUSTOMER")
  uploadedById    String?
  // PENDING | ACCEPTED | REJECTED
  status          String      @default("PENDING")
  rejectionReason String?
  // Retention: documents are deleted after this date.
  retentionDeleteAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  accessLogs      DocumentAccessLog[]

  @@index([applicationId])
  @@index([customerId])
}

model DocumentAccessLog {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  actorType  String
  actorId    String?
  actorEmail String?
  // VIEW | DOWNLOAD | DELETE | UPLOAD
  action     String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}
