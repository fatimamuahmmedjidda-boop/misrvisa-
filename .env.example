# Local dev: SQLite file, zero setup.
# Production (Vercel): set to a Postgres connection string (Neon / Vercel
# Postgres / Supabase) and switch prisma/schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Bootstrap admin account created by `npm run db:seed`.
ADMIN_EMAIL="admin@misrvisa.com"
ADMIN_PASSWORD="ChangeMe123!"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
